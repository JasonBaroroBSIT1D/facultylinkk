FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars-long

# Primary PostgreSQL database (required for API + migrations)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/facultylink

# Optional file uploads (relative to backend/ if not absolute)
UPLOAD_FOLDER=uploads

# CORS origins (comma-separated). Admin web on :8080; Flutter Web localhost ports are allowed automatically in development.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Gmail SMTP (App Password — never commit real values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=FacultyLink <your.address@gmail.com>

# Public URLs for activation links in email
WEB_PUBLIC_URL=http://127.0.0.1:8080
FORGOT_PASSWORD_RATE_LIMIT=8
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=3600

# Tesseract OCR (optional path on Windows; Linux uses PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Run OCR in-process after upload (dev); production should use: flask --app app ocr-worker
OCR_INLINE_AFTER_UPLOAD=true

# SET/SEF simulation auto-accept (default off; assesses on OCR only — no retroactive changes)
# SET_SEF_AUTO_APPROVAL_ENABLED=true
# SET_SEF_AUTO_APPROVAL_ALLOW_ADMIN_TOGGLE=true
